<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <!-- V6.74: customer experience after service -->
 <record id="view_ycc_feedback_tree" model="ir.ui.view">
  <field name="name">ycc.feedback.tree</field>
  <field name="model">ycc.feedback</field>
  <field name="arch" type="xml">
   <tree string="تجربة العملاء" create="false" decoration-danger="is_overdue" decoration-warning="is_unhappy" decoration-muted="state in ('unreachable','declined')" decoration-success="state == 'done' and rating_value &gt;= 4">
    <field name="is_overdue" invisible="1"/><field name="is_unhappy" invisible="1"/><field name="rating_value" invisible="1"/>
    <field name="due_date"/>
    <field name="partner_id"/>
    <field name="phone" widget="phone"/>
    <field name="appointment_id"/>
    <field name="branch_id"/>
    <field name="invoice_date" optional="hide"/>
    <field name="assigned_user_id"/>
    <field name="attempts" optional="show"/>
    <field name="state" widget="badge" decoration-info="state == 'due'" decoration-success="state == 'done'" decoration-muted="state in ('unreachable','declined')"/>
    <field name="rating" widget="badge" decoration-success="rating in ('5','4')" decoration-warning="rating == '3'" decoration-danger="rating in ('2','1')"/>
    <field name="done_by" optional="show"/>
    <button name="action_open_feedback_wizard" type="object" string="تواصل الآن" icon="fa-phone" class="btn-primary" attrs="{'invisible':[('state','!=','due')]}"/>
   </tree>
  </field>
 </record>

 <record id="view_ycc_feedback_form" model="ir.ui.view">
  <field name="name">ycc.feedback.form</field>
  <field name="model">ycc.feedback</field>
  <field name="arch" type="xml">
   <form string="تجربة العميل" create="false" class="ycc-feedback-form">
    <header>
     <button name="action_open_feedback_wizard" type="object" string="تواصل الآن وسجّل التقييم" icon="fa-phone" class="btn-primary" attrs="{'invisible':[('state','!=','due')]}"/>
     <button name="action_reopen" type="object" string="إعادة فتح" icon="fa-undo" groups="yousentech_car_appointments.group_ycc_manager" attrs="{'invisible':[('state','=','due')]}" confirm="إعادة فتح سجل تجربة العميل للتواصل مرة أخرى؟"/>
     <field name="state" widget="statusbar" statusbar_visible="due,done"/>
    </header>
    <sheet>
     <div class="oe_title"><h2><field name="partner_id" readonly="1" options="{'no_open': True}"/></h2>
      <div class="ycc-fb-sub"><field name="appointment_id" readonly="1"/> · <field name="phone" widget="phone" readonly="1"/></div>
     </div>
     <div class="ycc-fb-result" attrs="{'invisible':[('state','!=','done')]}">
      <span class="ycc-fb-result-label">مدى رضا العميل</span>
      <field name="rating" widget="badge" readonly="1" decoration-success="rating in ('5','4')" decoration-warning="rating == '3'" decoration-danger="rating in ('2','1')"/>
     </div>
     <group>
      <group string="الموعد">
       <field name="invoice_date" readonly="1"/>
       <field name="due_date" readonly="1"/>
       <field name="assigned_user_id" options="{'no_create': True, 'no_open': True}" readonly="1"/>
       <field name="attempts" readonly="1"/>
       <field name="is_overdue" invisible="1"/>
      </group>
      <group string="الخدمة">
       <field name="branch_id" readonly="1" options="{'no_open': True}"/>
       <field name="vehicle_plate" readonly="1"/>
       <field name="installation_order_id" readonly="1"/>
       <field name="booking_user_id" readonly="1" options="{'no_open': True}"/>
      </group>
      <group string="نتيجة التواصل" attrs="{'invisible':[('state','=','due')]}">
       <field name="channel" readonly="1"/>
       <field name="done_by" readonly="1" options="{'no_open': True}"/>
       <field name="done_at" readonly="1"/>
      </group>
     </group>
     <group attrs="{'invisible':[('note','=',False)]}"><field name="note" readonly="1"/></group>
    </sheet>
    <div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div>
   </form>
  </field>
 </record>

 <record id="view_ycc_feedback_search" model="ir.ui.view">
  <field name="name">ycc.feedback.search</field>
  <field name="model">ycc.feedback</field>
  <field name="arch" type="xml">
   <search string="تجربة العملاء">
    <field name="partner_id"/><field name="phone"/><field name="appointment_id"/><field name="assigned_user_id"/>
    <filter name="due" string="بانتظار التواصل" domain="[('state','=','due')]"/>
    <filter name="due_today" string="مستحقة حتى اليوم" domain="[('state','=','due'),('due_date','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
    <filter name="overdue" string="متأخرة" domain="[('is_overdue','=',True)]"/>
    <filter name="mine" string="مسندة لي" domain="[('assigned_user_id','=',uid)]"/>
    <separator/>
    <filter name="unhappy" string="غير راضين" domain="[('is_unhappy','=',True)]"/>
    <filter name="happy" string="راضون" domain="[('rating','in',['4','5'])]"/>
    <filter name="done" string="تم التقييم" domain="[('state','=','done')]"/>
    <filter name="unreachable" string="تعذر التواصل" domain="[('state','=','unreachable')]"/>
    <group expand="0" string="تجميع">
     <filter name="g_branch" string="الفرع" context="{'group_by':'branch_id'}"/>
     <filter name="g_rating" string="مدى الرضا" context="{'group_by':'rating'}"/>
     <filter name="g_user" string="سجّل التقييم" context="{'group_by':'done_by'}"/>
     <filter name="g_state" string="الحالة" context="{'group_by':'state'}"/>
    </group>
   </search>
  </field>
 </record>

 <record id="action_ycc_feedback" model="ir.actions.act_window">
  <field name="name">تجربة العملاء</field>
  <field name="res_model">ycc.feedback</field>
  <field name="view_mode">tree,form</field>
  <field name="search_view_id" ref="view_ycc_feedback_search"/>
  <field name="context">{'search_default_due': 1}</field>
  <field name="help" type="html"><p class="o_view_nocontent_smiling_face">لا توجد عملاء بانتظار التواصل</p><p>بعد إقفال فاتورة أمر التركيب بعدد الأيام المحدد في إعداد الفرع، يظهر العميل هنا للتواصل معه وتسجيل تقييمه للخدمة.</p></field>
 </record>
 <menuitem id="menu_ycc_feedback" name="تجربة العملاء" parent="qimamhd_wo_v3.work_order_operation_menu" action="action_ycc_feedback" sequence="82" groups="yousentech_car_appointments.group_ycc_booking"/>

 <record id="view_ycc_feedback_wizard_form" model="ir.ui.view">
  <field name="name">ycc.feedback.wizard.form</field>
  <field name="model">ycc.feedback.wizard</field>
  <field name="arch" type="xml">
   <form string="تسجيل تجربة العميل" class="ycc-feedback-wizard">
    <field name="feedback_id" invisible="1" force_save="1"/>
    <div class="ycc-fb-customer">
     <span class="fa fa-user-circle ycc-fb-avatar"/>
     <div class="ycc-fb-customer-body">
      <strong><field name="partner_id" readonly="1" options="{'no_open': True}"/></strong>
      <span><field name="phone" widget="phone" readonly="1"/> · <field name="appointment_id" readonly="1" options="{'no_open': True}"/> · <field name="vehicle_plate" readonly="1"/></span>
      <small>الفاتورة أُقفلت بتاريخ <field name="invoice_date" readonly="1"/><span attrs="{'invisible':[('attempts','=',0)]}"> · محاولات سابقة بدون رد: <field name="attempts" readonly="1"/></span></small>
     </div>
    </div>
    <group class="ycc-dc-main" col="2">
     <field name="outcome" widget="radio" options="{'horizontal': true}" required="1"/>
     <field name="channel" widget="radio" options="{'horizontal': true}"/>
     <field name="rating" widget="radio" class="ycc-fb-rating" attrs="{'invisible':[('outcome','!=','done')],'required':[('outcome','=','done')]}"/>
     <field name="note" placeholder="ماذا قال العميل عن الخدمة؟ (إجباري عند عدم الرضا)" attrs="{'required':[('outcome','=','done'),('rating','in',['1','2'])]}"/>
    </group>
    <div class="ycc-dc-hint"><span class="fa fa-info-circle"/> «لم يرد» يعيد المتابعة غدًا تلقائيًا (حتى 3 محاولات). التقييم «غير راضٍ» أو «غير راضٍ جدًا» يرسل تنبيهًا لمدير المواعيد لمعالجة الملاحظة مع العميل.</div>
    <footer><button name="action_apply" type="object" string="حفظ" class="btn-primary"/><button string="إلغاء" special="cancel" class="btn-secondary"/></footer>
   </form>
  </field>
 </record>

 <!-- branch setting -->
 <record id="view_ycc_branch_form_feedback" model="ir.ui.view">
  <field name="name">ycc.branch.form.feedback</field>
  <field name="model">ycc.branch</field>
  <field name="inherit_id" ref="yousentech_car_appointments.view_ycc_branch_form"/>
  <field name="arch" type="xml">
   <xpath expr="//field[@name='arrival_order_alert_minutes']" position="after">
    <field name="feedback_delay_days"/>
   </xpath>
  </field>
 </record>
</odoo>
