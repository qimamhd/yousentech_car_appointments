<record id="view_ycc_close_reason_wizard_form" model="ir.ui.view"><field name="name">ycc.close.reason.wizard.form</field><field name="model">ycc.close.reason.wizard</field><field name="arch" type="xml">
<form string="سبب الإلغاء أو عدم الحضور" class="ycc-close-reason-form"><sheet>
<field name="appointment_id" invisible="1" force_save="1"/><field name="target_state" invisible="1" force_save="1"/>
<group class="ycc-dc-main" col="2">
 <field name="cancel_reason" widget="radio" attrs="{'invisible':[('target_state','!=','cancelled')],'required':[('target_state','=','cancelled')]}"/>
 <field name="no_show_reason" widget="radio" attrs="{'invisible':[('target_state','!=','no_show')],'required':[('target_state','=','no_show')]}"/>
 <field name="reason" placeholder="تفاصيل إضافية (إجبارية عند اختيار «أخرى»)..." attrs="{'required':['|',('cancel_reason','=','other_cancel'),('no_show_reason','=','other_no_show')]}"/>
</group>
<div class="ycc-dc-hint"><span class="fa fa-info-circle"/> يُحفظ السبب مصنفًا لاستخدامه في لوحة مؤشرات المدير، ويُوثَّق في سجل المحادثات.</div>
</sheet><footer><button name="action_apply" type="object" string="تأكيد" class="btn-primary"/><button string="إلغاء" special="cancel" class="btn-secondary"/></footer></form></field></record>
<record id="view_ycc_delivery_change_wizard_form" model="ir.ui.view"><field name="name">ycc.delivery.change.wizard.form</field><field name="model">ycc.delivery.change.wizard</field><field name="arch" type="xml">
