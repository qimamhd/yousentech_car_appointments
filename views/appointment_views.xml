 <field name="groups_id" eval="[(4, ref('group_ycc_sales_arrival'))]"/>
 <field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="create">false</attribute><attribute name="edit">false</attribute><attribute name="delete">false</attribute></xpath></field>
</record>
<record id="view_ycc_contact_wizard_form" model="ir.ui.view">
<field name="name">ycc.contact.wizard.form</field><field name="model">ycc.contact.wizard</field>
<field name="arch" type="xml">
<form string="إضافة سجل تواصل" class="ycc-contact-wizard"><sheet><group>
<field name="appointment_id" invisible="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="contact_at"/><field name="user_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="channel"/>
<field name="result"/><field name="next_contact_at"/>
