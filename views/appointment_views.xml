<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ycc_branch_tree" model="ir.ui.view"><field name="name">ycc.branch.tree</field><field name="model">ycc.branch</field><field name="arch" type="xml"><tree><field name="branch_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="company_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="capacity"/><field name="provisional_minutes"/><field name="active"/></tree></field></record>
<record id="view_ycc_branch_form" model="ir.ui.view"><field name="name">ycc.branch.form</field><field name="model">ycc.branch</field><field name="arch" type="xml"><form string="تهيئة نظام المواعيد" class="ycc-config-form"><sheet><div class="oe_title"><h1><field name="branch_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/></h1></div><group string="إعدادات الفرع"><field name="company_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="capacity"/><field name="provisional_minutes"/><field name="active"/></group><div class="ycc-config-hint"><span class="fa fa-info-circle"/> القدرة الاستيعابية تحدد أقصى عدد سيارات في اليوم الواحد للفرع، وليست لكل فترة. السيارة المحجوزة في عدة فترات تُحسب مرة واحدة في كل يوم، والحجز الممتد يُحسب في كل يوم يشمله. الفترات أدناه لتحديد أوقات الاستقبال فقط.</div><notebook><page string="فترات استقبال السيارات"><field name="slot_ids"><tree editable="bottom"><field name="name" readonly="1"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="weekday_ids" widget="many2many_tags"/><field name="active"/></tree></field></page><page string="الإجازات والاستثناءات"><field name="exception_ids"><tree editable="bottom"><field name="date"/><field name="end_date" placeholder="نفس يوم البداية عند تركه فارغًا"/><field name="slot_id" domain="[('branch_id','=',parent.id)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="reason"/></tree></field></page></notebook></sheet></form></field></record>
<record id="view_ycc_appointment_tree" model="ir.ui.view"><field name="name">ycc.appointment.tree</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><tree decoration-success="state == 'confirmed'" decoration-warning="state in ('provisional','contacting')"><field name="name"/><field name="date"/><field name="end_date"/><field name="custom_branch_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="slot_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="end_slot_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="vehicle_plate"/><field name="car_manuf_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="car_type_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="service_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="state"/></tree></field></record>
<record id="view_ycc_appointment_form" model="ir.ui.view"><field name="name">ycc.appointment.form</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><form string="حجز موعد" class="ycc-appointment-form"><header><button groups="yousentech_car_appointments.group_ycc_booking" name="action_forecast_delivery_load" string="🔎 تحقق من السيارات الموجودة" type="object" class="oe_highlight ycc-forecast-main-button"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_contacting" string="جاري التواصل" type="object" states="provisional"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_confirm" string="تأكيد الموعد" type="object" class="oe_highlight" states="provisional,contacting"/><button groups="yousentech_car_appointments.group_ycc_sales_arrival,yousentech_car_appointments.group_ycc_booking" name="action_done" string="وصلت السيارة" type="object" states="confirmed"/><button groups="yousentech_car_appointments.group_ycc_sales_arrival,yousentech_car_appointments.group_ycc_booking" name="action_open_installation_wizard" string="إنشاء أمر تركيب" type="object" class="oe_highlight" attrs="{'invisible':['|',('state','!=','done'),('installation_order_id','!=',False)]}"/><field name="installation_order_id" invisible="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_no_show" string="لم يحضر" type="object" states="confirmed"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_cancel" string="إلغاء" type="object" states="provisional,contacting,confirmed"/><field name="state" widget="statusbar" statusbar_visible="provisional,contacting,confirmed,done"/></header><sheet class="ycc-appointment-sheet"><div class="oe_button_box" name="button_box" groups="yousentech_car_appointments.group_ycc_booking,yousentech_car_appointments.group_ycc_sales_arrival">
<button name="action_open_installation_order" type="object" class="oe_stat_button" icon="fa-wrench" attrs="{'invisible':[('installation_order_id','=',False)]}">
<div class="o_stat_info"><span class="o_stat_text">أمر التركيب</span><span class="o_stat_text">فتح الأمر المرتبط</span></div>
</button></div><div class="oe_title"><h1><field name="name"/></h1></div><div class="ycc-daily-form-panel"><div class="ycc-daily-form-title"><i class="fa fa-calendar-check-o"/> إشغال الفرع في تاريخ بداية الحجز <small>السعة يومية، وليست لكل فترة</small></div><group col="6"><field name="daily_capacity_view" readonly="1"/><field name="daily_booked_view" readonly="1"/><field name="daily_remaining_view" readonly="1"/></group><div class="ycc-daily-form-hint">الحجز في عدة فترات يُحسب سيارة واحدة في اليوم. إذا امتد الحجز إلى عدة أيام، يتحقق النظام من سعة كل يوم عند الحفظ.</div></div><group><group string="الموعد"><field name="branch_id" invisible="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="custom_branch_id" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="date"/><field name="end_date" placeholder="نفس يوم البداية عند تركه فارغًا"/><field name="slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="end_slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="hold_until" readonly="1"/><field name="agent_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/></group><group string="العميل والسيارة"><field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="phone" required="1"/><field name="vehicle_plate"/>
<field name="car_manuf_id" options="{'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
<field name="car_type_id" context="{'default_header_id': car_manuf_id}" options="{'no_quick_create': True, 'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
<field name="vehicle_model" readonly="1" attrs="{'invisible':[('vehicle_model','=',False)]}" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="service_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="installation_order_id" readonly="1" attrs="{'invisible':[('installation_order_id','=',False)]}" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/></group></group><div class="ycc-contact-panel">
  <div class="ycc-contact-heading">
    <div class="ycc-contact-title">
      <span class="fa fa-comments-o"/>
      <strong>سجل التواصل مع العميل</strong>
      <span class="ycc-contact-subtitle">متابعة المكالمات والرسائل والإجراءات</span>
    </div>
    <button groups="yousentech_car_appointments.group_ycc_booking" name="action_open_contact_wizard" type="object"
            string="إضافة سجل تواصل" class="btn-primary ycc-add-contact"
            icon="fa-plus"/>
  </div>
  <div class="ycc-contact-followup">
    <span class="fa fa-clock-o"/>
    <label for="next_contact_at" string="موعد المتابعة القادمة"/>
    <field name="next_contact_at" readonly="1" nolabel="1"/>
  </div>
  <div class="ycc-contact-table">
    <field name="contact_ids" nolabel="1" readonly="1">
      <tree string="سجل التواصل" create="false" edit="false" delete="false">
        <field name="contact_at" string="تاريخ ووقت التواصل"/>
        <field name="user_id" string="المندوب" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
        <field name="channel" string="الوسيلة"/>
        <field name="result" string="النتيجة"/>
        <field name="note" string="تفاصيل التواصل"/>
        <field name="next_contact_at" string="المتابعة القادمة"/>
      </tree>
    </field>
  </div>
</div>
<div class="ycc-notes-panel">
  <div class="ycc-notes-heading"><span class="fa fa-sticky-note-o"/> ملاحظات الحجز</div>
  <field name="notes" nolabel="1" placeholder="أضف ملاحظات عامة حول الحجز..."/>
</div>
</sheet><div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></form></field></record>
<record id="view_ycc_appointment_sales_restricted" model="ir.ui.view">
 <field name="name">ycc.appointment.sales.arrival.restricted</field>
 <field name="model">ycc.appointment</field>
 <field name="inherit_id" ref="view_ycc_appointment_form"/>
 <field name="groups_id" eval="[(4, ref('group_ycc_sales_arrival'))]"/>
 <field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="create">false</attribute><attribute name="edit">false</attribute><attribute name="delete">false</attribute></xpath></field>
</record>
<record id="view_ycc_contact_wizard_form" model="ir.ui.view">
<field name="name">ycc.contact.wizard.form</field><field name="model">ycc.contact.wizard</field>
<field name="arch" type="xml">
<form string="إضافة سجل تواصل" class="ycc-contact-wizard"><sheet><group>
<field name="appointment_id" invisible="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="contact_at"/><field name="user_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="channel"/>
<field name="result"/><field name="next_contact_at"/>
<field name="note" placeholder="اكتب ملخص المكالمة أو المحادثة..."/>
</group></sheet><footer>
<button name="action_save_contact" string="حفظ سجل التواصل" type="object" class="btn-primary"/>
<button string="إلغاء" special="cancel" class="btn-secondary"/>
</footer></form></field></record>
<record id="view_ycc_native_installation_header" model="ir.ui.view">
<field name="name">ycc.wo.installation.native.header.form</field>
<field name="model">wo.installation.order.mst</field>
<field name="arch" type="xml">
<form string="إنشاء أمر تركيب — بيانات الهيدر" class="ycc-installation-header-form" create="1" edit="1">
<sheet><div class="ycc-installation-head"><span class="fa fa-car"/><div><h2>إنشاء أمر تركيب</h2><p>بيانات الحجز جاهزة، أكمل بيانات الهيدر ثم احفظ للانتقال إلى أمر التركيب.</p></div></div>
<group><group string="العميل والفرع">
<field name="partner_id" required="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="partner_mobile"/>
<field name="branch_id" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="order_date" required="1"/>
</group><group string="السيارة والتسليم">
<field name="car_manuf_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="car_type_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="car_size_id" required="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="car_panel_no"/>
<field name="delivery_date"/><field name="delivery_period" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
</group></group>
<field name="seq" invisible="1"/><field name="state" invisible="1"/>
<field name="ycc_appointment_id" invisible="1"/>
</sheet>
<footer>
<button name="action_ycc_open_full_order" type="object" string="حفظ وفتح أمر التركيب" class="btn-primary ycc-installation-save"/>
<button string="إلغاء" special="cancel" class="btn-secondary"/>
</footer></form>
</field></record>
<record id="view_ycc_forecast_wizard_form" model="ir.ui.view"><field name="name">ycc.forecast.wizard.form</field><field name="model">ycc.forecast.wizard</field><field name="arch" type="xml"><form string="التحقق من السيارات الموجودة"><sheet><field name="details" widget="html" readonly="1" nolabel="1"/></sheet><footer><button string="إغلاق" special="cancel" class="btn-primary"/></footer></form></field></record>
<record id="view_ycc_service_tree" model="ir.ui.view"><field name="name">ycc.service.tree</field><field name="model">ycc.service</field><field name="arch" type="xml"><tree editable="bottom"><field name="name"/><field name="estimated_hours"/><field name="active"/></tree></field></record>
<record id="action_ycc_branch" model="ir.actions.act_window"><field name="name">تهيئة نظام المواعيد</field><field name="res_model">ycc.branch</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_appointment" model="ir.actions.act_window"><field name="name">المواعيد</field><field name="res_model">ycc.appointment</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_service" model="ir.actions.act_window"><field name="name">خدمات العناية</field><field name="res_model">ycc.service</field><field name="view_mode">tree,form</field></record>
<menuitem id="menu_ycc_calendar" name="تقويم المواعيد" parent="qimamhd_wo_v3.work_order_operation_menu" action="action_ycc_calendar" sequence="80"/>
<menuitem id="menu_ycc_appointment" name="المواعيد" parent="qimamhd_wo_v3.work_order_operation_menu" action="action_ycc_appointment" sequence="81"/>
<menuitem id="menu_ycc_settings" name="تهيئة نظام المواعيد" parent="qimamhd_wo_v3.work_order_setup_menu" action="action_ycc_branch" sequence="80"/>
<menuitem id="menu_ycc_services" name="خدمات المواعيد" parent="qimamhd_wo_v3.work_order_setup_menu" action="action_ycc_service" sequence="81"/>
</odoo>
