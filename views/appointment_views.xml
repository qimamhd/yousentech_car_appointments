 <div class="ycc-dc-info-item"><span class="fa fa-wrench"/><small>أمر التركيب</small><field name="installation_order_id" readonly="1" options="{'no_open': True, 'no_create': True}"/></div>
 <div class="ycc-dc-info-item"><span class="fa fa-calendar-o"/><small>موعد التسليم الحالي</small><field name="old_date" readonly="1" force_save="1"/></div>
</div>
<group class="ycc-dc-main" col="2">
 <field name="new_date" required="1"/>
 <field name="reason" widget="radio" options="{'horizontal': true}" required="1"/>
 <field name="note" required="1" placeholder="اكتب سبب تغيير موعد التسليم بالتفصيل..."/>
</group>
<div class="ycc-dc-hint"><span class="fa fa-info-circle"/> يُحدَّث موعد التسليم في أمر التركيب مباشرة، ويُسجَّل التغيير مع نوع السبب والسبب والمستخدم في سجل تغييرات موعد التسليم وسجل المحادثات.</div>
</sheet><footer><button name="action_apply" type="object" string="حفظ التغيير" class="btn-primary"/><button string="إلغاء" special="cancel" class="btn-secondary"/></footer></form></field></record>

