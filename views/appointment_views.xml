<record id="view_ycc_branch_form" model="ir.ui.view"><field name="name">ycc.branch.form</field><field name="model">ycc.branch</field><field name="arch" type="xml"><form string="تهيئة نظام المواعيد" class="ycc-config-form"><sheet><div class="oe_title"><h1><field name="branch_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/></h1></div><group string="إعدادات الفرع"><field name="company_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="capacity"/><field name="check_capacity"/><field name="provisional_minutes"/><field name="arrival_order_alert_minutes"/><field name="active"/></group><div class="ycc-config-hint"><span class="fa fa-info-circle"/> القدرة الاستيعابية تحدد أقصى عدد سيارات في اليوم الواحد للفرع، وليست لكل فترة. السيارة المحجوزة في عدة فترات تُحسب مرة واحدة في كل يوم، والحجز الممتد يُحسب في كل يوم يشمله. الفترات أدناه لتحديد أوقات الاستقبال فقط.</div><notebook><page string="فترات استقبال السيارات"><field name="slot_ids"><tree editable="bottom"><field name="name" readonly="1"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="weekday_ids" widget="many2many_tags"/><field name="active"/></tree></field></page><page string="الإجازات والاستثناءات"><field name="exception_ids"><tree editable="bottom"><field name="date"/><field name="end_date" placeholder="نفس يوم البداية عند تركه فارغًا"/><field name="slot_id" domain="[('branch_id','=',parent.id)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="reason"/></tree></field></page></notebook></sheet></form></field></record>
<record id="view_ycc_appointment_tree" model="ir.ui.view"><field name="name">ycc.appointment.tree</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><tree decoration-success="state == 'confirmed'" decoration-warning="state in ('provisional','contacting')"><field name="name"/><field name="date"/><field name="is_check_only"/><field name="end_date" groups="yousentech_car_appointments.group_ycc_manager"/><field name="custom_branch_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="slot_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="end_slot_id" groups="yousentech_car_appointments.group_ycc_manager" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="partner_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="vehicle_plate"/><field name="agency_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="car_type_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="close_reason_code" optional="show"/><field name="cancellation_reason" readonly="1" attrs="{'invisible':[ ('cancellation_reason','=',False)]}"/><field name="service_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="state"/></tree></field></record>
<record id="view_ycc_appointment_form" model="ir.ui.view"><field name="name">ycc.appointment.form</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><form string="حجز موعد" class="ycc-appointment-form"><header><button groups="yousentech_car_appointments.group_ycc_booking" name="action_forecast_delivery_load" string="🔎 تحقق من السيارات الموجودة" type="object" class="oe_highlight ycc-forecast-main-button"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_contacting" string="جاري التواصل" type="object" states="provisional"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_confirm" string="تأكيد الموعد" type="object" class="oe_highlight" states="provisional,contacting"/><button groups="yousentech_car_appointments.group_ycc_sales_arrival,yousentech_car_appointments.group_ycc_booking" name="action_done" string="وصلت السيارة" type="object" states="confirmed"/><button groups="yousentech_car_appointments.group_ycc_sales_arrival,yousentech_car_appointments.group_ycc_booking" name="action_complete_check_only" string="اكتمال التشييك" type="object" class="oe_highlight" attrs="{'invisible':['|',('is_check_only','=',False),('state','!=','done')]}"/><button groups="yousentech_car_appointments.group_ycc_sales_arrival,yousentech_car_appointments.group_ycc_booking" name="action_open_installation_wizard" string="إنشاء أمر تركيب" type="object" class="oe_highlight" attrs="{'invisible':['|','|',('state','!=','done'),('installation_order_id','!=',False),('is_check_only','=',True)]}"/><field name="installation_order_id" invisible="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="ycc_is_manager" invisible="1"/><button groups="yousentech_car_appointments.group_ycc_manager" name="action_back_to_provisional" string="إرجاع إلى حجز مبدئي" type="object" icon="fa-undo" confirm="سيُعاد الحجز إلى مبدئي بمهلة جديدة حسب إعداد الفرع، ويُحسب ضمن السعة ما دامت المهلة سارية. متابعة؟" attrs="{'invisible':['|','|',('state','!=','confirmed'),('installation_order_id','!=',False),('actual_arrival_at','!=',False)]}"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_no_show" string="لم يحضر العميل" type="object" states="confirmed"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_cancel" string="إلغاء" type="object" states="provisional,contacting,confirmed"/><button groups="yousentech_car_appointments.group_ycc_booking" name="action_open_postpone" string="تأجيل الموعد" type="object" states="provisional,contacting,confirmed,postponed"/><button name="action_open_delivery_change" type="object" string="تغيير موعد التسليم" class="oe_highlight" icon="fa-calendar" groups="yousentech_car_appointments.group_ycc_booking" attrs="{'invisible':[('installation_order_id','=',False)]}"/>
<field name="state" widget="statusbar" statusbar_visible="provisional,contacting,confirmed,postponed,done,installation_created,inspection_completed"/></header><sheet class="ycc-appointment-sheet"><div class="oe_button_box" name="button_box" groups="yousentech_car_appointments.group_ycc_booking,yousentech_car_appointments.group_ycc_sales_arrival">
<button name="action_open_installation_order" type="object" class="oe_stat_button" icon="fa-wrench" attrs="{'invisible':[('installation_order_id','=',False)]}">
<div class="o_stat_info"><span class="o_stat_text">أمر التركيب</span><span class="o_stat_text">فتح الأمر المرتبط</span></div>
</button></div><div class="oe_title"><h1><field name="name"/></h1></div><div class="ycc-daily-form-panel"><div class="ycc-daily-form-title"><i class="fa fa-calendar-check-o"/> إشغال الفرع في تاريخ بداية الحجز <small>السعة يومية، وليست لكل فترة</small></div><group col="6"><field name="daily_capacity_view" readonly="1"/><field name="daily_booked_view" readonly="1"/><field name="daily_remaining_view" readonly="1"/></group><div class="ycc-daily-form-hint">الحجز في عدة فترات يُحسب سيارة واحدة في اليوم. إذا امتد الحجز إلى عدة أيام، يتحقق النظام من سعة كل يوم عند الحفظ.</div></div><group><group string="الموعد"><field name="branch_id" required="1" context="{'ycc_allowed_only': True}" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="custom_branch_id" invisible="1"/><field name="date" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="is_check_only" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="end_date" groups="yousentech_car_appointments.group_ycc_manager" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}" placeholder="نفس يوم البداية عند تركه فارغًا"/><field name="slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="end_slot_id" groups="yousentech_car_appointments.group_ycc_manager" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}" domain="[('branch_id','=',branch_id),('active','=',True)]" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/><field name="hold_until" readonly="1"/><field name="agent_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/></group><group string="العميل والسيارة"><field name="partner_id" options="{'no_open': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="phone" required="1" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="vehicle_plate" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/>
<field name="agency_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/>
<field name="car_type_id" options="{'no_open': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/>
<field name="vehicle_model" readonly="1" attrs="{'invisible':[('vehicle_model','=',False)]}" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<field name="close_reason_code" readonly="1" attrs="{'invisible':[('close_reason_code','=',False)]}"/><field name="cancellation_reason" readonly="1" attrs="{'invisible':[ ('cancellation_reason','=',False)]}"/><field name="service_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}"/><field name="installation_order_id" readonly="1" attrs="{'invisible':[('installation_order_id','=',False)]}" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/></group></group>
<div class="ycc-arrival-audit-panel"><div class="ycc-arrival-audit-title"><i class="fa fa-info-circle"/> مؤشر خدمة العملاء</div><div class="ycc-lifecycle-bar"><field name="service_stage" widget="statusbar" readonly="1" statusbar_visible="provisional,confirmed,done,installation_created,completed,invoice_closed"/></div><group><field name="service_stage" readonly="1" widget="badge"/><field name="invoice_state_label" readonly="1" attrs="{'invisible':[('installation_order_id','=',False)]}"/><field name="was_postponed" readonly="1"/><field name="postponement_count" readonly="1" attrs="{'invisible':[('was_postponed','=',False)]}"/><field name="last_postponement_reason" readonly="1" attrs="{'invisible':[('was_postponed','=',False)]}"/></group><div class="ycc-postponed-note">عند تأجيل الموعد يعود الحجز إلى مبدئي، وتبقى علامة التأجيل ظاهرة حتى بعد التأكيد. تفاصيل الموعد السابق والسبب موثقة في سجل المحادثات.</div></div>
<div class="ycc-arrival-audit-panel">
  <div class="ycc-arrival-audit-title"><i class="fa fa-history"/> سجل الوصول والتواريخ</div>
  <div class="ycc-arrival-audit-help">موعد الحجز مخطط، أما وصول السيارة فيُسجل وقت الضغط على «وصلت السيارة». تاريخ طلب أمر التركيب يُقرأ مباشرة من الأمر المرتبط، وأي اختلاف موثق في سجل المحادثات أسفل الشاشة.</div>
  <group col="4">
    <field name="date" readonly="1" string="تاريخ الحجز المخطط"/>
    <field name="actual_arrival_at" readonly="1" string="الوصول الفعلي"/>
    <field name="check_date" readonly="1" string="تاريخ موعد التشييك" attrs="{'invisible':[('installation_order_id','=',False)]}"/>
    <field name="installation_order_date" readonly="1" string="تاريخ طلب أمر التركيب" attrs="{'invisible':[('installation_order_id','=',False)]}"/>
    <field name="installation_date_notice" readonly="1" string="ملاحظة مقارنة التواريخ" attrs="{'invisible':[('installation_order_id','=',False)]}"/>
  </group>
</div>
<div class="ycc-arrival-audit-panel" attrs="{'invisible':[('installation_order_id','=',False)]}">
 <div class="ycc-arrival-audit-title"><i class="fa fa-calendar"/> موعد التسليم وسجل التعديلات</div>
 
 <field name="delivery_change_ids" nolabel="1" readonly="1"><tree create="false" edit="false" delete="false"><field name="change_date"/><field name="old_date"/><field name="new_date"/><field name="reason_code"/><field name="reason"/><field name="user_id"/></tree></field>
</div>
<div class="ycc-contact-panel">
  <div class="ycc-contact-heading">
    <div class="ycc-contact-title">
      <span class="fa fa-comments-o"/>
      <strong>سجل التواصل مع العميل</strong>
      <span class="ycc-contact-subtitle">متابعة المكالمات والرسائل والإجراءات</span>
    </div>
    <button groups="yousentech_car_appointments.group_ycc_booking" name="action_open_contact_wizard" type="object"
            string="إضافة سجل تواصل" class="btn-primary ycc-add-contact"
            icon="fa-plus"/>
  </div>
  <div class="ycc-contact-followup">
    <span class="fa fa-clock-o"/>
    <label for="next_contact_at" string="موعد المتابعة القادمة"/>
    <field name="next_contact_at" readonly="1" nolabel="1"/>
  </div>
  <div class="ycc-contact-table">
    <field name="contact_ids" nolabel="1" readonly="1">
      <tree string="سجل التواصل" create="false" edit="false" delete="false">
        <field name="contact_at" string="تاريخ ووقت التواصل"/>
        <field name="user_id" string="المندوب" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
        <field name="channel" string="الوسيلة"/>
        <field name="result" string="النتيجة"/>
        <field name="note" string="تفاصيل التواصل"/>
        <field name="next_contact_at" string="المتابعة القادمة"/>
      </tree>
    </field>
  </div>
</div>
<div class="ycc-notes-panel">
  <div class="ycc-notes-heading"><span class="fa fa-sticky-note-o"/> ملاحظات الحجز</div>
  <field name="notes" nolabel="1" attrs="{'readonly':['&amp;',('installation_order_id','!=',False),('ycc_is_manager','=',False)]}" placeholder="أضف ملاحظات عامة حول الحجز..."/>
</div>
</sheet><div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></form></field></record>
