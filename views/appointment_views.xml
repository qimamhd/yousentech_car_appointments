<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ycc_branch_tree" model="ir.ui.view"><field name="name">ycc.branch.tree</field><field name="model">ycc.branch</field><field name="arch" type="xml"><tree><field name="branch_id"/><field name="company_id"/><field name="provisional_minutes"/><field name="active"/></tree></field></record>
<record id="view_ycc_branch_form" model="ir.ui.view"><field name="name">ycc.branch.form</field><field name="model">ycc.branch</field><field name="arch" type="xml"><form string="تهيئة نظام المواعيد"><sheet><div class="oe_title"><h1><field name="branch_id" options="{'no_create': True}"/></h1></div><group><field name="company_id"/><field name="provisional_minutes"/><field name="active"/></group><notebook><page string="فترات الحجز"><field name="slot_ids"><tree editable="bottom"><field name="name" readonly="1"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="capacity"/><field name="weekday_ids" widget="many2many_tags"/><field name="active"/></tree></field></page><page string="الإجازات والاستثناءات"><field name="exception_ids"><tree editable="bottom"><field name="date"/><field name="slot_id" domain="[('branch_id','=',parent.id)]"/><field name="reason"/></tree></field></page></notebook></sheet></form></field></record>
<record id="view_ycc_appointment_tree" model="ir.ui.view"><field name="name">ycc.appointment.tree</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><tree decoration-success="state == 'confirmed'" decoration-warning="state in ('provisional','contacting')"><field name="name"/><field name="date"/><field name="custom_branch_id"/><field name="slot_id"/><field name="end_slot_id"/><field name="partner_id"/><field name="vehicle_plate"/><field name="car_manuf_id"/><field name="car_type_id"/><field name="service_id"/><field name="state"/></tree></field></record>
<record id="view_ycc_appointment_form" model="ir.ui.view"><field name="name">ycc.appointment.form</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><form string="حجز موعد"><header><button name="action_contacting" string="جاري التواصل" type="object" states="provisional"/><button name="action_confirm" string="تأكيد الموعد" type="object" class="oe_highlight" states="provisional,contacting"/><button name="action_done" string="وصلت السيارة" type="object" states="confirmed"/><button name="action_no_show" string="لم يحضر" type="object" states="confirmed"/><button name="action_cancel" string="إلغاء" type="object" states="provisional,contacting,confirmed"/><field name="state" widget="statusbar" statusbar_visible="provisional,contacting,confirmed,done"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="الموعد"><field name="branch_id" invisible="1"/><field name="custom_branch_id" readonly="1"/><field name="date"/><field name="slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]"/><field name="end_slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]"/><field name="hold_until" readonly="1"/><field name="agent_id"/></group><group string="العميل والسيارة"><field name="partner_id"/><field name="phone"/><field name="vehicle_plate"/>
<field name="car_manuf_id" options="{'no_create_edit': False}"/>
<field name="car_type_id" context="{'default_header_id': car_manuf_id}" options="{'no_quick_create': True}"/>
<field name="vehicle_model" readonly="1" attrs="{'invisible':[('vehicle_model','=',False)]}"/>
<field name="service_id"/></group></group><separator string="سجل التواصل مع العميل" colspan="2"/>
<div class="oe_button_box" name="contact_actions">
<button name="action_open_contact_wizard" type="object" string="إضافة سجل تواصل" class="oe_highlight btn btn-primary" icon="fa-phone"/>
</div>
<group><field name="next_contact_at" string="موعد المتابعة القادمة" readonly="1"/></group>
<field name="contact_ids" nolabel="1" colspan="2" readonly="1">
<tree string="سجل التواصل" create="false" delete="false">
<field name="contact_at" string="تاريخ ووقت التواصل"/>
<field name="user_id"/><field name="channel"/><field name="result"/>
<field name="note"/><field name="next_contact_at"/>
</tree>
</field>
<notebook><page string="الملاحظات"><field name="notes"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></form></field></record>
<record id="view_ycc_contact_wizard_form" model="ir.ui.view">
<field name="name">ycc.contact.wizard.form</field><field name="model">ycc.contact.wizard</field>
<field name="arch" type="xml">
<form string="إضافة سجل تواصل"><sheet><group>
<field name="appointment_id" invisible="1"/>
<field name="contact_at"/><field name="user_id"/><field name="channel"/>
<field name="result"/><field name="next_contact_at"/>
<field name="note" placeholder="اكتب ملخص المكالمة أو المحادثة..."/>
</group></sheet><footer>
<button name="action_save_contact" string="حفظ سجل التواصل" type="object" class="btn-primary"/>
<button string="إلغاء" special="cancel" class="btn-secondary"/>
</footer></form></field></record>
<record id="view_ycc_service_tree" model="ir.ui.view"><field name="name">ycc.service.tree</field><field name="model">ycc.service</field><field name="arch" type="xml"><tree editable="bottom"><field name="name"/><field name="estimated_hours"/><field name="active"/></tree></field></record>
<record id="action_ycc_branch" model="ir.actions.act_window"><field name="name">تهيئة نظام المواعيد</field><field name="res_model">ycc.branch</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_appointment" model="ir.actions.act_window"><field name="name">المواعيد</field><field name="res_model">ycc.appointment</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_service" model="ir.actions.act_window"><field name="name">خدمات العناية</field><field name="res_model">ycc.service</field><field name="view_mode">tree,form</field></record>
<menuitem id="menu_ycc_calendar" name="تقويم المواعيد" parent="qimamhd_wo_v3.work_order_operation_menu" action="action_ycc_calendar" sequence="80"/>
<menuitem id="menu_ycc_appointment" name="المواعيد" parent="qimamhd_wo_v3.work_order_operation_menu" action="action_ycc_appointment" sequence="81"/>
<menuitem id="menu_ycc_settings" name="تهيئة نظام المواعيد" parent="qimamhd_wo_v3.work_order_setup_menu" action="action_ycc_branch" sequence="80"/>
<menuitem id="menu_ycc_services" name="خدمات المواعيد" parent="qimamhd_wo_v3.work_order_setup_menu" action="action_ycc_service" sequence="81"/>
</odoo>
