<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="ycc.Calendar">
<div class="ycc-board" t-att-dir="rtl ? 'rtl' : 'ltr'">
 <div class="ycc-head"><div><div class="ycc-eyebrow">العناية بالسيارات / العمليات</div><h1><i class="fa fa-calendar-check-o"/> تقويم المواعيد</h1><p>تخطيط فترات استقبال السيارات · حماية PPF · تظليل · عناية</p></div><button class="ycc-new btn btn-primary"><i class="fa fa-plus"/> حجز مبدئي جديد</button></div>
 <div class="ycc-toolbar"><label>الفرع<select class="ycc-branch form-control"><t t-foreach="branches" t-as="b"><option t-att-value="b.id" t-att-selected="b.id === branchId ? 'selected' : undefined"><t t-esc="b.name"/></option></t></select></label><div class="ycc-navigation"><button class="ycc-prev">‹</button><strong><t t-esc="periodLabel"/></strong><small><t t-esc="hijriLabel"/></small><button class="ycc-next">›</button><button class="ycc-today">اليوم</button></div><div class="ycc-switch"><button t-att-class="mode === 'week' ? 'active ycc-mode-week' : 'ycc-mode-week'">أسبوعي</button><button t-att-class="mode === 'month' ? 'active ycc-mode-month' : 'ycc-mode-month'">شهري</button></div></div>
 <div class="ycc-kpis"><div class="stat-capacity"><small>إجمالي السعة</small><strong><t t-esc="summary.capacity"/></strong></div><div class="stat-booked"><small>إشغال الفترات</small><strong><t t-esc="summary.occupied"/></strong></div><div class="stat-confirmed"><small>مواعيد مؤكدة</small><strong><t t-esc="summary.confirmed"/></strong></div><div class="stat-hold"><small>حجوزات مبدئية</small><strong><t t-esc="summary.provisional"/></strong></div></div>
 <div class="ycc-legend"><span><i class="dot free"/> شاغر بالكامل</span><span><i class="dot partial"/> متاح مع حجوزات</span><span><i class="dot busy"/> شبه ممتلئ</span><span><i class="dot full"/> مكتمل</span><span><i class="dot past"/> فترة منتهية</span><span><i class="dot closed"/> مغلق</span></div>
 <div class="ycc-grid-wrap"><table class="ycc-grid"><thead><tr><th class="ycc-day-heading">اليوم / الفترة</th><t t-foreach="slots" t-as="s"><th><strong><t t-esc="s.name"/></strong><small>السعة <t t-esc="s.capacity"/></small></th></t></tr></thead><tbody><t t-foreach="rows" t-as="row"><tr><th class="ycc-day-heading"><strong><t t-esc="row.label"/></strong><small><t t-esc="row.hijri"/></small></th><t t-foreach="row.cells" t-as="cell"><td><button t-att-class="'ycc-cell '+cell.css" t-att-data-date="cell.date" t-att-data-slot="cell.slot_id" t-att-disabled="!cell.open ? 'disabled' : undefined"><strong><t t-esc="cell.open ? cell.count+'/'+cell.capacity : '—'"/></strong><small><t t-esc="!cell.open ? 'غير متاح' : cell.css === 'past' ? 'انتهت الفترة' : cell.remaining ? 'متبقي '+cell.remaining : 'مكتمل'"/></small><t t-if="cell.hasSpan"><span class="ycc-span-label"><i class="fa fa-arrows-h"/> حجز ممتد</span></t><t t-foreach="cell.bookings.slice(0,2)" t-as="booking"><span class="ycc-mini-booking" t-att-title="booking.client+' · '+booking.service"><t t-esc="booking.client"/></span></t></button></td></t></tr></t></tbody></table></div>
 <t t-if="!slots.length"><div class="ycc-empty">لا توجد فترات مهيأة لهذا الفرع.</div></t>
</div>
</t>
<t t-name="ycc.PeriodModal">
<div class="modal-dialog modal-lg ycc-dialog" role="document"><div class="modal-content"><div class="modal-header"><h4 class="modal-title">تفاصيل حجوزات الفترة</h4><button type="button" class="close ycc-close">×</button></div><div class="modal-body"><div class="ycc-modal-intro"><div><small>الفرع · التاريخ · الفترة</small><strong><t t-esc="branchName"/> · <t t-esc="date"/> · <t t-esc="slotName"/></strong></div><div class="ycc-occupancy"><strong><t t-esc="bookings.length"/> / <t t-esc="capacity"/></strong><small>سيارات</small></div></div><div class="ycc-progress"><span t-att-style="'width:'+Math.min(100,Math.round(bookings.length*100/capacity))+'%'"/></div><div class="ycc-modal-stats"><span>مؤكد: <b><t t-esc="confirmed"/></b></span><span>مبدئي: <b><t t-esc="provisional"/></b></span><span>متاح: <b><t t-esc="Math.max(0,capacity-bookings.length)"/></b></span></div><t t-foreach="bookings" t-as="b"><div class="ycc-booking"><div><strong><t t-esc="b.client"/></strong><small><t t-esc="b.vehicle"/> · <t t-esc="b.service"/></small><small><t t-esc="b.name"/> · <t t-esc="b.agent"/></small><t t-if="b.slot_ids.length &gt; 1"><small class="ycc-span-label">حجز ممتد: <t t-esc="b.slot_ids.length"/> فترات متتالية</small></t><t t-if="b.hold_until"><small>انتهاء الحجز المبدئي: <t t-esc="b.hold_until"/></small></t></div><div><span t-att-class="'ycc-state '+b.state"><t t-esc="b.state === 'confirmed' ? 'مؤكد' : b.state === 'done' ? 'وصل' : 'مبدئي'"/></span><button class="ycc-open-booking btn btn-link" t-att-data-id="b.id">فتح الحجز</button></div></div></t><t t-if="!bookings.length"><div class="ycc-empty">لا توجد سيارات في هذه الفترة.</div></t></div><div class="modal-footer"><button class="btn btn-secondary ycc-close">إغلاق</button><t t-if="bookings.length &lt; capacity"><button class="btn btn-primary ycc-create-period">+ حجز مبدئي</button></t></div></div></div>
</t>
</templates>
