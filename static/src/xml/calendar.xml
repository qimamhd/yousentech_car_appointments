<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="ycc.Calendar">
<div class="ycc-board" t-att-dir="rtl ? 'rtl' : 'ltr'">
 <div class="ycc-head"><div class="ycc-head-title"><div class="ycc-title-icon"><i class="fa fa-calendar-check-o"/></div><div><div class="ycc-eyebrow">العناية بالسيارات <i class="fa fa-angle-left"/> العمليات</div><h1>تقويم المواعيد</h1><p>نظرة موحدة على حجوزات الفروع وفترات استقبال السيارات</p></div></div><button class="ycc-new btn btn-primary"><i class="fa fa-plus"/> حجز مبدئي جديد</button></div>
 <div class="ycc-toolbar"><label><i class="fa fa-map-marker"/> الفرع<select class="ycc-branch form-control"><t t-foreach="branches" t-as="b"><option t-att-value="b.id" t-att-selected="b.id === branchId ? 'selected' : undefined"><t t-esc="b.name"/></option></t></select></label><div class="ycc-date-control" role="group" aria-label="التنقل بين التواريخ">
   <button type="button" class="ycc-date-arrow ycc-prev" title="الفترة السابقة" aria-label="الفترة السابقة"><i class="fa fa-chevron-right"/></button>
   <div class="ycc-date-caption"><span class="ycc-date-main"><i class="fa fa-calendar-o"/><t t-esc="periodLabel"/></span><span class="ycc-date-hijri"><t t-esc="hijriLabel"/></span></div>
   <button type="button" class="ycc-date-arrow ycc-next" title="الفترة التالية" aria-label="الفترة التالية"><i class="fa fa-chevron-left"/></button>
   <button type="button" class="ycc-today">اليوم</button>
  </div><div class="ycc-switch"><button t-att-class="mode === 'week' ? 'active ycc-mode-week' : 'ycc-mode-week'">أسبوعي</button><button t-att-class="mode === 'month' ? 'active ycc-mode-month' : 'ycc-mode-month'">شهري</button></div></div>
 <div class="ycc-kpis"><div class="stat-capacity"><span class="ycc-kpi-icon"><i class="fa fa-car"/></span><small>السعة الإجمالية للفترات</small><strong><t t-esc="summary.capacity"/></strong><em>مكان استقبال</em></div><div class="stat-booked"><span class="ycc-kpi-icon"><i class="fa fa-pie-chart"/></span><small>إشغال الفترات</small><strong><t t-esc="summary.occupied"/></strong><em>فترة مشغولة</em></div><div class="stat-confirmed"><span class="ycc-kpi-icon"><i class="fa fa-check-circle"/></span><small>المواعيد المؤكدة</small><strong><t t-esc="summary.confirmed"/></strong><em>حجز مؤكد</em></div><div class="stat-hold"><span class="ycc-kpi-icon"><i class="fa fa-clock-o"/></span><small>الحجوزات المبدئية</small><strong><t t-esc="summary.provisional"/></strong><em>بانتظار المتابعة</em></div></div>
 <div class="ycc-board-section"><div class="ycc-section-heading"><div><strong><i class="fa fa-th-large"/> جدول الإشغال</strong><small>اختر أي فترة لاستعراض السيارات وحالة الحجز</small></div><span class="ycc-section-chip"><i class="fa fa-link"/> الحجوزات الممتدة تظهر بعلامة خاصة</span></div><div class="ycc-legend"><span><i class="dot free"/> شاغر بالكامل</span><span><i class="dot partial"/> متاح مع حجوزات</span><span><i class="dot busy"/> شبه ممتلئ</span><span><i class="dot full"/> مكتمل</span><span><i class="dot past"/> فترة منتهية</span><span><i class="dot closed"/> مغلق</span></div>
 <div class="ycc-grid-wrap"><table class="ycc-grid"><thead><tr><th class="ycc-day-heading">اليوم / الفترة</th><t t-foreach="slots" t-as="s"><th><strong><t t-esc="s.name"/></strong><small>السعة <t t-esc="s.capacity"/></small></th></t></tr></thead><tbody><t t-foreach="rows" t-as="row"><tr><th class="ycc-day-heading"><strong><t t-esc="row.label"/></strong><small><t t-esc="row.hijri"/></small></th><t t-foreach="row.cells" t-as="cell"><td><button t-att-class="'ycc-cell '+cell.css+(cell.bookings.length ? ' ycc-style-12' : '')+(cell.hasArrived ? ' ycc-has-arrived' : '')" t-att-data-date="cell.date" t-att-data-slot="cell.slot_id" t-att-disabled="!cell.open ? 'disabled' : undefined">
<t t-if="cell.bookings.length">
<span class="ycc-12-icon"><i class="fa fa-car"/></span>
<span class="ycc-12-occupancy"><strong><t t-esc="cell.count+'/'+cell.capacity"/></strong><small><t t-esc="cell.remaining ? 'متبقي '+cell.remaining : 'مكتمل'"/></small></span>
<span class="ycc-12-people"><span class="ycc-12-people-top">
<t t-foreach="cell.bookings.slice(0,1)" t-as="booking"><span class="ycc-mini-booking" t-att-title="booking.client+' · '+booking.service"><t t-esc="booking.client"/></span></t>
<t t-if="cell.bookings.length &gt; 1"><span class="ycc-12-extra">+<t t-esc="cell.bookings.length-1"/></span></t>
</span><span class="ycc-12-sub"><t t-if="cell.hasArrived"><span class="ycc-arrived-chip"><i class="fa fa-check-circle"/> وصلت <t t-esc="cell.arrivedCount"/></span></t><t t-if="cell.hasSpan"><i class="fa fa-link"/> <t t-esc="cell.spanCount"/> حجز ممتد</t><t t-if="!cell.hasSpan"><i class="fa fa-calendar-check-o"/> عرض الحجوزات</t></span></span>
<span class="ycc-12-menu"><i class="fa fa-ellipsis-v"/></span>
</t>
<t t-if="!cell.bookings.length"><strong><t t-esc="cell.open ? cell.count+'/'+cell.capacity : '—'"/></strong><small><t t-esc="!cell.open ? 'غير متاح' : cell.css === 'past' ? 'انتهت الفترة' : cell.remaining ? 'متبقي '+cell.remaining : 'مكتمل'"/></small></t>
</button></td></t></tr></t></tbody></table></div>
 <t t-if="!slots.length"><div class="ycc-empty">لا توجد فترات مهيأة لهذا الفرع.</div></t></div>
</div>
</t>
<t t-name="ycc.PeriodModal">
<div class="modal-dialog modal-lg ycc-dialog" role="document"><div class="modal-content"><div class="modal-header"><div><small class="ycc-modal-eyebrow">تقويم المواعيد / تفاصيل الفترة</small><h4 class="modal-title"><i class="fa fa-calendar-check-o"/> حجوزات الفترة</h4></div><button type="button" class="close ycc-close" aria-label="إغلاق">×</button></div><div class="modal-body"><div class="ycc-modal-intro"><div><small>الفرع · التاريخ · الفترة</small><strong><t t-esc="branchName"/> · <t t-esc="date"/> · <t t-esc="slotName"/></strong></div><div class="ycc-occupancy"><strong><t t-esc="bookings.length"/> / <t t-esc="capacity"/></strong><small>سيارات</small></div></div><div class="ycc-progress"><span t-att-style="'width:'+Math.min(100,Math.round(bookings.length*100/capacity))+'%'"/></div><div class="ycc-modal-stats"><span class="ycc-stat-confirmed">مؤكد: <b><t t-esc="confirmed"/></b></span><span class="ycc-stat-arrived">وصلت: <b><t t-esc="arrived"/></b></span><span class="ycc-stat-hold">مبدئي: <b><t t-esc="provisional"/></b></span><span class="ycc-stat-available">متاح: <b><t t-esc="Math.max(0,capacity-bookings.length)"/></b></span></div><t t-foreach="bookings" t-as="b"><div t-att-class="'ycc-booking ycc-booking-'+b.state" t-att-data-id="b.id" role="button" tabindex="0" title="اضغط لفتح الحجز"><div><strong><t t-esc="b.client"/></strong><small><t t-esc="b.vehicle"/> · <t t-esc="b.service"/></small><small><t t-esc="b.name"/> · <t t-esc="b.agent"/></small><t t-if="b.periods.length &gt; 1"><small class="ycc-span-label">حجز ممتد: <t t-esc="b.date"/> إلى <t t-esc="b.end_date"/> · <t t-esc="b.periods.length"/> فترة</small></t><t t-if="b.hold_until"><small>انتهاء الحجز المبدئي: <t t-esc="b.hold_until"/></small></t></div><div><span t-att-class="'ycc-state '+b.state"><t t-esc="b.state === 'confirmed' ? 'مؤكد' : b.state === 'done' ? 'وصلت السيارة' : 'مبدئي'"/></span><button class="ycc-open-booking btn btn-link" t-att-data-id="b.id">فتح الحجز</button></div></div></t><t t-if="!bookings.length"><div class="ycc-empty">لا توجد سيارات في هذه الفترة.</div></t></div><div class="modal-footer"><button class="btn btn-primary ycc-forecast-period"><i class="fa fa-search"/> تحقق من السيارات الموجودة</button><button class="btn btn-secondary ycc-close">إغلاق</button><t t-if="bookings.length &lt; capacity"><button class="btn btn-primary ycc-create-period">+ حجز مبدئي</button></t></div></div></div>
</t>
</templates>
