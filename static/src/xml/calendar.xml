<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="ycc.Calendar"><div class="ycc-board" dir="rtl">
<div class="ycc-head"><div><small>العناية بالسيارات / العمليات</small><h1><i class="fa fa-calendar-check-o"/> تقويم المواعيد</h1><p>PPF · التظليل · العناية بالسيارات</p></div><button class="ycc-new btn btn-primary"><i class="fa fa-plus"/> حجز مبدئي جديد</button></div>
<div class="ycc-toolbar"><label>الفرع <select class="ycc-branch form-control"><t t-foreach="branches" t-as="b"><option t-att-value="b.id" t-att-selected="b.id === branchId ? 'selected' : undefined"><t t-esc="b.name"/></option></t></select></label><div class="ycc-nav"><button class="ycc-prev">‹</button><div><strong><t t-esc="periodLabel"/></strong><small><t t-esc="hijriLabel"/></small></div><button class="ycc-next">›</button><button class="ycc-today">اليوم</button></div><div class="ycc-switch"><button t-att-class="mode === 'week' ? 'active ycc-mode-week' : 'ycc-mode-week'">أسبوعي</button><button t-att-class="mode === 'month' ? 'active ycc-mode-month' : 'ycc-mode-month'">شهري</button></div></div>
<div class="ycc-kpis"><div><small>السعة الإجمالية</small><strong><t t-esc="summary.capacity"/></strong></div><div><small>السيارات المحجوزة</small><strong><t t-esc="summary.occupied"/></strong></div><div><small>المواعيد المؤكدة</small><strong><t t-esc="summary.confirmed"/></strong></div><div><small>الحجوزات المبدئية</small><strong><t t-esc="summary.provisional"/></strong></div></div>
<div class="ycc-legend"><span>🟢 متاح</span><span>🟡 قارب الامتلاء</span><span>🔴 مكتمل</span><span>⚪ مغلق / غير معرّف</span><span>اضغط على الفترة لعرض السيارات</span></div>
<div class="ycc-grid-wrap"><table class="ycc-grid"><thead><tr><th>الفترة</th><t t-foreach="days" t-as="d"><th><strong><t t-esc="d.label"/></strong><small><t t-esc="d.hijri"/></small></th></t></tr></thead><tbody><t t-foreach="rows" t-as="row"><tr><th><t t-esc="row.name"/></th><t t-foreach="row.cells" t-as="cell"><td><button t-att-class="'ycc-cell '+cell.css" t-att-data-date="cell.date" t-att-data-slot="cell.slot_id" t-att-disabled="!cell.open ? 'disabled' : undefined"><strong><t t-esc="cell.open ? cell.count+'/'+cell.capacity : '—'"/></strong><small><t t-esc="cell.open ? (cell.remaining ? 'متبقي '+cell.remaining : 'مكتمل') : 'غير متاح'"/></small></button></td></t></tr></t></tbody></table></div>
<t t-if="!rows.length"><div class="ycc-empty">لا توجد فترات مهيأة لهذا الفرع</div></t>
</div></t>
<t t-name="ycc.PeriodModal"><div class="modal-dialog modal-lg ycc-dialog" role="document"><div class="modal-content" dir="rtl"><div class="modal-header"><h4 class="modal-title">تفاصيل حجوزات الفترة</h4><button type="button" class="close ycc-close">×</button></div><div class="modal-body"><div class="ycc-modal-intro"><div><small>الفرع · التاريخ · الفترة</small><strong><t t-esc="branchName"/> · <t t-esc="date"/> · <t t-esc="slotName"/></strong></div><div class="ycc-occupancy"><strong><t t-esc="bookings.length"/> / <t t-esc="capacity"/></strong><small>سيارات</small></div></div><div class="ycc-progress"><span t-att-style="'width:'+Math.min(100,Math.round(bookings.length*100/capacity))+'%'"/></div><div class="ycc-modal-stats"><span>مؤكد: <b><t t-esc="confirmed"/></b></span><span>مبدئي: <b><t t-esc="provisional"/></b></span><span>المتاح: <b><t t-esc="Math.max(0,capacity-bookings.length)"/></b></span></div><t t-foreach="bookings" t-as="b"><div class="ycc-booking"><div><strong><t t-esc="b.client"/></strong><small><t t-esc="b.vehicle"/> · <t t-esc="b.service"/></small><small><t t-esc="b.name"/> · <t t-esc="b.agent"/></small><t t-if="b.hold_until"><small>انتهاء المبدئي: <t t-esc="b.hold_until"/></small></t></div><div><span t-att-class="'ycc-state '+b.state"><t t-esc="b.state === 'confirmed' ? 'مؤكد' : b.state === 'done' ? 'وصل' : 'مبدئي'"/></span><button class="ycc-open-booking btn btn-link" t-att-data-id="b.id">فتح الحجز</button></div></div></t><t t-if="!bookings.length"><div class="ycc-empty">لا توجد سيارات في الفترة</div></t></div><div class="modal-footer"><button class="btn btn-secondary ycc-close">إغلاق</button><t t-if="bookings.length &lt; capacity"><button class="btn btn-primary ycc-create-period" t-att-data-date="date" t-att-data-slot="slotId">+ حجز مبدئي</button></t></div></div></div></t>
</templates>
